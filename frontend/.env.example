# ============================================================
# Frontend Environment Variables (Vite)
# Copy this file to frontend/.env and set your backend / Render URL
# ============================================================

# Backend / Render URL (e.g. https://your-backend-service.onrender.com)
# Leave empty locally to use Vite's /api proxy to http://localhost:8080
VITE_API_URL=
VITE_RENDER_URL=
VITE_BACKEND_URL=
